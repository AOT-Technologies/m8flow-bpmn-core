<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  id="mapped_child"
  targetNamespace="https://m8flow.example/bpmn">
  <bpmn:process id="child_process" name="Mapped child" isExecutable="true">
    <bpmn:ioSpecification>
      <bpmn:dataInput id="child_input" name="child_input" />
      <bpmn:dataOutput id="child_output" name="child_output" />
      <bpmn:inputSet><bpmn:dataInputRefs>child_input</bpmn:dataInputRefs></bpmn:inputSet>
      <bpmn:outputSet><bpmn:dataOutputRefs>child_output</bpmn:dataOutputRefs></bpmn:outputSet>
    </bpmn:ioSpecification>
    <bpmn:startEvent id="child_start" />
    <bpmn:scriptTask id="child_transform" name="Transform input">
      <bpmn:script>child_output = child_input + " mapped"</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="child_end" />
    <bpmn:sequenceFlow id="mapped_1" sourceRef="child_start" targetRef="child_transform" />
    <bpmn:sequenceFlow id="mapped_2" sourceRef="child_transform" targetRef="child_end" />
  </bpmn:process>
</bpmn:definitions>
