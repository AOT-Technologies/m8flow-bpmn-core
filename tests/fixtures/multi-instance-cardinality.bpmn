<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_mi_card" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_multi_instance_cardinality" name="Multi-instance cardinality" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:scriptTask id="prep" name="Set count" scriptFormat="python">
      <bpmn:script>count = 3</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="mi_seq" name="Sequential, literal cardinality">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality>3</bpmn:loopCardinality>
        <bpmn:loopDataOutputRef>seq_out</bpmn:loopDataOutputRef>
        <bpmn:inputDataItem id="i1" name="i1" />
        <bpmn:outputDataItem id="o1" name="o1" />
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:script>o1 = (i1 + 1) * 10</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="mi_par" name="Parallel, expression cardinality">
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:loopCardinality>count</bpmn:loopCardinality>
        <bpmn:loopDataOutputRef>par_out</bpmn:loopDataOutputRef>
        <bpmn:inputDataItem id="i2" name="i2" />
        <bpmn:outputDataItem id="o2" name="o2" />
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:script>o2 = (i2 + 1) * 10</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="chk" name="Check results" scriptFormat="python">
      <bpmn:script>mi_ok = (list(seq_out) == [10, 20, 30] and sorted(par_out) == [10, 20, 30])
if not mi_ok: raise Exception('multi-instance cardinality FAILED')</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="EndEvent_1" name="Cardinality OK" />
    <bpmn:sequenceFlow id="f1" sourceRef="StartEvent_1" targetRef="prep" />
    <bpmn:sequenceFlow id="f2" sourceRef="prep" targetRef="mi_seq" />
    <bpmn:sequenceFlow id="f3" sourceRef="mi_seq" targetRef="mi_par" />
    <bpmn:sequenceFlow id="f4" sourceRef="mi_par" targetRef="chk" />
    <bpmn:sequenceFlow id="f5" sourceRef="chk" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_multi_instance_cardinality">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1"><dc:Bounds x="160" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="prep_di" bpmnElement="prep"><dc:Bounds x="246" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mi_seq_di" bpmnElement="mi_seq"><dc:Bounds x="396" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mi_par_di" bpmnElement="mi_par"><dc:Bounds x="546" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="chk_di" bpmnElement="chk"><dc:Bounds x="696" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1"><dc:Bounds x="846" y="142" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="196" y="160" /><di:waypoint x="246" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="346" y="160" /><di:waypoint x="396" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="496" y="160" /><di:waypoint x="546" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="646" y="160" /><di:waypoint x="696" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="796" y="160" /><di:waypoint x="846" y="160" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
